# CONFIGURACIÓN DE ENTORNO - TECNOTALLER
# Copia este archivo como .env y actualiza los valores según tu entorno.
# NO subas el archivo .env al repositorio.

# Base de Datos Oracle
DB_USER=tu_usuario_oracle
DB_PASSWORD=tu_contraseña_oracle
DB_CONNECTION_STRING=localhost:1521/ORCLPDB

# Servidor
PORT=3000

# JWT (Autenticación) 
# Genera una clave segura, por ejemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_segura_y_larga

# CORS
# Orígenes permitidos separados por coma (ej: http://localhost:3000,http://midominio.com)
CORS_ORIGINS=http://localhost:3000

# Mock Database (Desarrollo / Pruebas sin Oracle)
# Si se establece en true, el proyecto se ejecutará usando una base de datos en memoria 
# con datos semilla iniciales y no requerirá una base de datos Oracle configurada.
USE_MOCK_DB=true

